      "image": "crpi-1u9nmrh29ouue3ym.cn-hongkong.personal.cr.aliyuncs.com/asnk-forge/forgejo-runner-go:runner-13.1.0",
      "labels": ["acs-go"],
      "maxReplicas": 10,
      "resources": {
        "limits": {
          "cpu": "2",
          "ephemeral-storage": "30Gi",
          "memory": "4Gi"
        },
        "requests": {
          "cpu": "2",
          "ephemeral-storage": "30Gi",
          "memory": "4Gi"
        }
      }
    },
    "nix": {
      "image": "crpi-1u9nmrh29ouue3ym.cn-hongkong.personal.cr.aliyuncs.com/asnk-forge/forgejo-runner-nix:runner-13.1.0",
